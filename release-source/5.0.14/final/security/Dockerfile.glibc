FROM nyxguardmanager:5.0.14-rc@sha256:9373bdb794b01d68b0d33364cd0cca462a99d0efd90e31a84a49841f12da7a5b AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y dpkg-dev gettext file quilt autoconf gawk debhelper rdfind symlinks netbase gperf bison libaudit-dev libcap-dev libselinux1-dev g++-12 libgd-dev
COPY final/security/libc-vendor /vendor
COPY final/security/build-glibc.py /build-glibc.py
WORKDIR /work
RUN python3 /build-glibc.py
FROM scratch AS packages
COPY --from=build /out/ /
