FROM nyxguardmanager:5.0.14-rc@sha256:9373bdb794b01d68b0d33364cd0cca462a99d0efd90e31a84a49841f12da7a5b AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -o Dpkg::Options::=--force-confold install -y dpkg-dev debhelper autoconf automake dh-exec groff-base libbrotli-dev libgnutls28-dev libidn2-dev libkrb5-dev libldap2-dev libnghttp2-dev libnss3-dev libpsl-dev librtmp-dev libssh2-1-dev libssl-dev libtool libzstd-dev quilt zlib1g-dev pkg-config openssh-server python3-h2 gnutls-bin stunnel4
COPY final/security/curl-vendor /vendor
COPY final/security/build-curl.py /build-curl.py
WORKDIR /work
RUN python3 /build-curl.py
FROM scratch AS packages
COPY --from=build /out/ /
