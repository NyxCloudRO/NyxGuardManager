+/* Linux ACL caller backport.  O_PATH avoids blocking or opening devices.
+   Retain the object selected by creation or by the existing identity check;
+   ACL restoration must never re-resolve the untrusted original pathname. */
+static void
+nyx_acl_close (int *fd)
+{
+  int saved_errno = errno;
+  if (*fd >= 0)
+    close (*fd);
+  errno = saved_errno;
+}
+
+static int
+nyx_acl_create (int kind, char const *name, mode_t mode, dev_t dev, int *pin)
+{
+  char *parent = dir_name (name);
+  char *leaf = base_name (name);
+  strip_trailing_slashes (leaf);
+  int parentfd = openat (chdir_fd, parent, O_PATH | O_DIRECTORY | O_CLOEXEC);
+  int result = -1;
+  if (parentfd >= 0)
+    {
+      result = (kind == 0 ? mkdirat (parentfd, leaf, mode)
+                : kind == 1 ? mkfifoat (parentfd, leaf, mode)
+                : mknodat (parentfd, leaf, mode, dev));
+      if (result == 0)
+        *pin = openat (parentfd, leaf, O_PATH | O_CLOEXEC | O_NOFOLLOW);
+    }
+  int saved_errno = errno;
+  if (parentfd >= 0)
+    close (parentfd);
+  free (parent);
+  free (leaf);
+  errno = saved_errno;
+  return result;
+}
