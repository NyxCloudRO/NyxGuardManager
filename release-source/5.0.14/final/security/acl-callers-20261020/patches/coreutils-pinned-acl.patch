+/* Linux release backport: resolve an ACL object once, check its identity,
+   and keep it alive across metadata operations.  O_PATH does not open devices
+   or block on FIFOs and does not add a read-permission requirement.  The
+   kernel-generated procfs reference names this descriptor's object, even if
+   a pathname ancestor is subsequently replaced.  Never fall back to NAME. */
+static void
+nyx_acl_close (int *fd)
+{
+  int saved_errno = errno;
+  if (*fd >= 0)
+    close (*fd);
+  errno = saved_errno;
+}
+
+static int
+nyx_acl_pin (int dirfd, char const *name, struct stat const *expected,
+             int flags)
+{
+  int fd = openat (dirfd, name, O_PATH | O_CLOEXEC | flags);
+  struct stat actual;
+  if (fd < 0)
+    return -1;
+  if (fstat (fd, &actual) != 0)
+    {
+      int saved_errno = errno;
+      close (fd);
+      errno = saved_errno;
+      return -1;
+    }
+  if (S_ISLNK (actual.st_mode)
+      || (expected && (! SAME_INODE (actual, *expected)
+                       || (actual.st_mode & S_IFMT)
+                          != (expected->st_mode & S_IFMT))))
+    {
+      close (fd);
+      errno = ESTALE;
+      return -1;
+    }
+  return fd;
+}
