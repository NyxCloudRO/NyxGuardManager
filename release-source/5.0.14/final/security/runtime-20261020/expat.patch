+XML_Bool XMLCALL
+XML_SetHashSalt16Bytes(XML_Parser parser, const uint8_t entropy[16]) {
+  if (parser == NULL || entropy == NULL)
+    return XML_FALSE;
+  while (parser->m_parentParser != NULL)
+    parser = parser->m_parentParser;
+  if (parserBusy(parser))
+    return XML_FALSE;
+  sip_tokey(&parser->m_hash_secret_salt_128, entropy);
+  parser->m_hash_secret_salt_set = XML_TRUE;
+  ENTROPY_DEBUG("explicit(16)", parser->m_hash_secret_salt_128);
+  return XML_TRUE;
 }
 
